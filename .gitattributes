# Shell scripts must keep LF even on a Windows checkout — CRLF breaks the shebang
# ("bad interpreter: /usr/bin/env^M") in Git Bash and WSL.
* text=auto eol=lf
*.sh text eol=lf
*.md text eol=lf

# Batch files are the opposite: cmd.exe can mis-execute LF-only .bat files,
# particularly around labels and goto.
*.bat text eol=crlf
*.cmd text eol=crlf
