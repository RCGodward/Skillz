.DS_Store
eval/replay/

# Review logs name real repos, branches, and defects in someone else's code.
# This repo is public. Keep them local; only the template is tracked.
eval/log/*.md
!eval/log/TEMPLATE.md

# plugin eval output: reports embed full transcripts.
*/evals/results/

# Built submission ZIP (certification/package.sh)
certification/dist/

# Session files claude plugin eval writes next to a case when it resumes history.jsonl.
# They record the full request context, including account details: never commit them.
branch-review/evals/*/*-*-*-*-*.jsonl
__pycache__/
